# WORKHIVE OAuth configuration
# Copy this file to `.env.local` and fill in real values to enable the
# provider redirect flows. Leaving the values empty keeps the app in
# "demo mode" where the social login buttons simulate the round-trip.
#
# Required set-up per provider:
#   1. Google  -> https://console.cloud.google.com/apis/credentials
#      Create an OAuth 2.0 Client ID (Web application) and add your app
#      URL + "/auth/callback/google" to "Authorized redirect URIs".
#   2. Microsoft (Entra ID / Azure AD) -> https://entra.microsoft.com
#      Register an app, add a Web platform credential with your app URL +
#      "/auth/callback/microsoft" as the redirect URI, and note the
#      application (client) ID and Directory (tenant) ID.
#
# Never commit real credentials. Client secrets must not be stored here;
# the implicit flow used by this SPA only requires the public client ID.

# Google OAuth client id (public identifier only — never a secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Microsoft Entra ID application (client) id (public identifier only)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Microsoft Entra ID directory (tenant) id — "common" allows any tenant
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common